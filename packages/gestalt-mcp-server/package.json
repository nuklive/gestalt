{
  "name": "gestalt-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for the Gestalt design system component library",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gestalt-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "node --loader ts-node/esm src/index.ts",
    "dev:http": "node --loader ts-node/esm src/index.ts --http",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "start:http": "node dist/index.js --http",
    "start:http:custom": "node dist/index.js --http --port=3000"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gestalt",
    "design-system",
    "pinterest"
  ],
  "author": "Pinterest",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "typescript": "5.6.2"
  },
  "files": [
    "dist"
  ]
}
